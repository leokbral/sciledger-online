import { compile } from 'svelte/compiler';
import { readFileSync } from 'node:fs';
const f = process.argv[2];
try {
  const { warnings } = compile(readFileSync(f, 'utf8'), { filename: f, generate: 'server' });
  const real = warnings.filter(w => !/a11y|css_unused/i.test(w.code || ''));
  console.log('OK', f, real.length ? '(warn: ' + real.map(w => w.code + ':' + w.message).join(' | ') + ')' : '');
} catch (e) { console.log('FAIL', f, '\n  ', e.message); process.exit(1); }
